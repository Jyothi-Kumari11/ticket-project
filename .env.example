# ResolveDesk Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ticket-management?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=ticket-management

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Server
PORT=5001
NODE_ENV=development
